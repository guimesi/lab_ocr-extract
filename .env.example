# ============================================================
# Databricks (Claude via Foundation Model API / serving endpoint)
# ============================================================
# Workspace URL, e.g. https://adb-1234567890123456.7.azuredatabricks.net
# (WITHOUT the /serving-endpoints suffix - the app appends it)
DATABRICKS_HOST=
# Personal Access Token (User Settings > Developer > Access tokens)
DATABRICKS_TOKEN=
# Serving endpoint name (check "Serving" in your workspace).
# Common pay-per-token endpoints: databricks-claude-sonnet-4-5,
# databricks-claude-opus-4-1, databricks-claude-3-7-sonnet
DATABRICKS_MODEL=databricks-claude-sonnet-4-5

# ============================================================
# Snowflake (optional - enables the "table reference" feature)
# ============================================================
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
# Sample rows shown to the model as formatting examples (0 = schema only)
SNOWFLAKE_SAMPLE_ROWS=5
# Reference table offered by default in the sidebar (structured extraction)
SNOWFLAKE_DEFAULT_TABLE=INSIGHTS_DB.UC_EPCDF_PRD_RSTR.GP_WWBS_HISTORICAL

# ============================================================
# PDF handling
# ============================================================
# Max PDF pages rendered (0 = no limit)
PDF_MAX_PAGES=0
# Pages sent to the model per call (large PDFs are processed in batches)
PDF_PAGES_PER_CALL=10
