# ============================================================
# Databricks (Claude via Foundation Model API / serving endpoint)
# Required for OCR of scanned pages, image/chart descriptions and
# the AI chat. Native-text extraction works without it.
# ============================================================
# Workspace URL, e.g. https://adb-1234567890123456.7.azuredatabricks.net
# (WITHOUT the /serving-endpoints suffix - the app appends it)
DATABRICKS_HOST=
# Personal Access Token (User Settings > Developer > Access tokens)
DATABRICKS_TOKEN=
# Serving endpoint name (check "Serving" in your workspace).
# Common pay-per-token endpoints: databricks-claude-sonnet-4-5,
# databricks-claude-opus-4-1, databricks-claude-3-7-sonnet
DATABRICKS_MODEL=databricks-claude-sonnet-4-5

# ============================================================
# PDF processing
# ============================================================
# Max PDF pages processed (0 = no limit)
PDF_MAX_PAGES=0
# Reject uploads larger than this many MB
MAX_UPLOAD_MB=100
# Output-token budget per model call (OCR / chat replies)
LLM_MAX_TOKENS=16000
# Parallel model calls during processing (OCR pages, image descriptions)
LLM_CONCURRENCY=6
# Cap on AI-described images/charts per document
MAX_IMAGE_DESCRIPTIONS=12
# Character budget for the document context sent to the chat model;
# larger documents degrade to outline + selected section
CHAT_CONTEXT_CHARS=60000

# ============================================================
# Snowflake (unused on this branch - kept for master merges)
# ============================================================
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
SNOWFLAKE_SAMPLE_ROWS=5
SNOWFLAKE_DEFAULT_TABLE=INSIGHTS_DB.UC_EPCDF_PRD_RSTR.GP_WBS_HISTORICAL
